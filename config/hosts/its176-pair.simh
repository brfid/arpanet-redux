# Boot the host-176 ITS image and connect its NCP interface to IMP 62.
expect -p "DSKDMP" send "L\e2\eNITS\rIMPUS=\eG\r" ; continue

set console wru=034
set cpu its
set cpu 1024k
set cpu idle
set cpu mpx
set pd enabled
set pd on

set imp enabled
set imp ncp
set imp mpx=4
attach -u imp %BRFID_HOST_B_IMP_PORT%:127.0.0.1:%BRFID_IMP62_HI_PORT%

set dpa noheaders
attach ptr ./dskdmp.rim
attach dpa0 ./rp03.2
attach dpa1 ./rp03.3
attach dpa2 ./rp03.0
attach dpa3 ./rp03.1

set throttle 35%
boot ptr
