expect -p "DSKDMP" send "L\e2\eNITS\rIMPUS=\eG\r" ; continue
expect -p "DO YOU REALLY WANT THE SYSTEM TO GO DOWN?\r_" send "yc\c"
expect -p "BUGPC/   CAI COFFI4+1   $Q-2/   JRST COFFI7" exit

set console wru=034
set cpu its
set cpu 1024k
set cpu idle
set cpu mpx
set rpa disabled
set rpb disabled
set tua disabled
set fha disabled
set dpb disabled
set lpt disabled
set cr disabled
set dc disabled
set dtc disabled
set dk disabled
set pd enabled
set pd on
set tk disabled
set dpk disabled
set mty disabled

set imp enabled
set imp ncp
attach -u imp %BRFID_HOST_A_IMP_PORT%:127.0.0.1:%BRFID_IMP6_HI_PORT%

set ch disabled
attach ptr ./dskdmp.rim
attach dpa0 ./rp03.2
attach dpa1 ./rp03.3
attach dpa2 ./rp03.0
attach dpa3 ./rp03.1
set mta mpx=7
set mta type=b
set dt mpx=6
set imp mpx=4
set dpa noheaders
set imx enabled mpx=3
set imx channel=2;unit0;axis0;negate
set imx channel=3;unit0;axis1
set imx channel=10;unit0;axis3;negate
set imx channel=5;unit1;axis0;negate
set imx channel=6;unit1;axis1
set imx channel=30;unit1;axis3;negate
set imx channel=70;unit2;axis0
set imx channel=71;unit2;axis1;negate
set imx channel=73;unit2;axis3
set imx channel=77;unit3;axis0
set imx channel=76;unit3;axis1;negate
set imx channel=74;unit3;axis3

set throttle 35%
boot ptr
