# IMP 7 joins the NCC triangle and carries the application alternate path.
set debug stdout
do %BRFID_H316_MINI_ROOT%/impconfig.simh
set imp num=7
do %BRFID_H316_MINI_ROOT%/impcode.simh

set mi1 enabled
set mi1 debug
attach -u mi1 %BRFID_IMP7_TO5_PORT%:127.0.0.1:%BRFID_IMP5_ALT_PORT%
set mi2 enabled
set mi2 debug
attach -u mi2 %BRFID_IMP7_TO6_PORT%:127.0.0.1:%BRFID_IMP6_ALT_PORT%
set mi3 enabled
set mi3 debug
attach -u mi3 %BRFID_IMP7_TO62_PORT%:127.0.0.1:%BRFID_IMP62_TO7_PORT%

set hi1 disabled

set throttle 10000K
go
